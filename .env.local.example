# ==============================================================================
# KELLY'S CAKE - GUÍA DE VARIABLES DE ENTORNO PARA PRODUCCIÓN (VERCEL)
# ==============================================================================

# --- SUPABASE (Base de Datos & Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_publishable_key (sb_publishable_...)
SUPABASE_SERVICE_ROLE_KEY=tu_secret_key (sb_secret_...)

# --- UBICACIÓN TALLER KELLY'S CAKE (AREQUIPA) ---
NEXT_PUBLIC_BAKERY_LAT=-16.423017084298532
NEXT_PUBLIC_BAKERY_LNG=-71.51597134574365

# --- GOOGLE MAPS (Cálculo de Envíos en Checkout) ---
# Restringir por HTTP Referrer en Google Cloud Console para: https://tudominio.pe/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu_google_maps_api_key

# --- INTELIGENCIA ARTIFICIAL (FoodOS Factura OCR) ---
# Obtener gratuita en Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=tu_gemini_api_key

# --- PASARELAS DE PAGO (OPCIONALES / ACTIVAR CUANDO SE DESEE COBRO CON TARJETA) ---
# Culqi: https://culqi.com
NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_test_xxxxxxxx
CULQI_SECRET_KEY=sk_test_xxxxxxxx

# Mercado Pago: https://mercadopago.com.pe
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-xxxxxxxx
MP_ACCESS_TOKEN=TEST-xxxxxxxx

# Resend (Emails transaccionales - opcional)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Kellys Cake <hola@kellyscake.pe>

# --- CRON DE RESEÑAS (Vercel) ---
# Secreto que autoriza al cron diario (/api/cron/resenas) que envía
# el email de solicitud de reseña 2 días después de cada entrega.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=tu_cron_secret

# --- SINCRONIZACION CONTAPRO (agente en PC) ---
# Secreto compartido entre el agente (scripts/contapro-sync/config.json)
# y este servidor: sin él nadie puede inyectar datos contables.
# Genera uno con el mismo comando de arriba.
CONTAPRO_SYNC_SECRET=tu_contapro_sync_secret

# --- WHATSAPP ADMIN (CallMeBot - aviso de nuevos pedidos) ---
# Registro inicial (una sola vez) desde el WhatsApp del admin:
# enviar "I allow callmebot to send me messages" al +34 644 66 32 66
# y copiar la apikey que llega al chat.
# Guía: https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_CALLMEBOT_APIKEY=tu_callmebot_apikey

# --- NOTIFICACIONES PUSH (Web Push / VAPID) ---
# Genera tus claves con: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY: publica (necesaria en el navegador para suscribirse)
# VAPID_PRIVATE_KEY: secreta (solo servidor, para enviar)
# NEXT_PUBLIC_VAPID_SUBJECT: identidad del emisor
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu_vapid_public_key
VAPID_PRIVATE_KEY=tu_vapid_private_key
NEXT_PUBLIC_VAPID_SUBJECT=mailto:hola@kellyscake.pe
